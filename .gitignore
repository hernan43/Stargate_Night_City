/out/
/dist/
/firmware/**/build/
/firmware/**/*.bin
/firmware/**/*.elf
/firmware/**/*.hex
/firmware/**/*.map
/firmware/**/*.o
/firmware/**/*.a
*.ino.cpp
*.ino.cpp.d

