/.arduino15/
/.arduinoIDE/
/.arduino-cli/
/.pio/
/.cache/
/arduino-cli.yaml
/compile_commands.json

# Python test and tooling artifacts
__pycache__/
*.py[cod]
/.venv/
/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

